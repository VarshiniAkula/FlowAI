{
  "id": "support_flow",
  "description": "Handles technical support requests",
  "nodes": {
    "start": {
      "id": "start",
      "type": "message",
      "text": "Let us troubleshoot your issue.",
      "next": "issue_type"
    },
    "issue_type": {
      "id": "issue_type",
      "type": "choice",
      "text": "Select issue type: login, bug, outage",
      "choices": {
        "login": "login_steps",
        "bug": "bug_steps",
        "outage": "outage_steps"
      },
      "default": "agent_handoff"
    },
    "login_steps": {
      "id": "login_steps",
      "type": "message",
      "text": "Try resetting your password and ensure 2FA device time is correct.",
      "next": "end"
    },
    "bug_steps": {
      "id": "bug_steps",
      "type": "message",
      "text": "Please share app version, steps to reproduce, and screenshots.",
      "next": "end"
    },
    "outage_steps": {
      "id": "outage_steps",
      "type": "message",
      "text": "Check status page first. If outage persists, we have created a ticket.",
      "next": "end"
    },
    "agent_handoff": {
      "id": "agent_handoff",
      "type": "message",
      "text": "I am routing you to technical support.",
      "next": "end"
    },
    "end": {
      "id": "end",
      "type": "message",
      "text": "Support flow complete.",
      "next": null
    }
  },
  "start_node": "start"
}
