# FlowMind — environment variables.
# Copy this file to `.env.local` (gitignored) and fill in real values from
# your Supabase project dashboard. Never commit `.env.local`.

# Supabase project URL (e.g. https://xxx.supabase.co).
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Legacy name: anon key.
# Safe to expose to the browser. RLS enforces per-user access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key. BYPASSES RLS.
# MUST NEVER be exposed to the browser. Every file that imports this key
# must start with `import 'server-only'`.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key for embeddings (text-embedding-004) + chat (gemini-2.5-flash).
# Server-only.
GEMINI_API_KEY=

# Public app URL (no trailing slash). Used for auth redirects, invite URLs,
# hosted chat links, and the embed snippet served by /widget.js.
# Examples:
#   Local:      http://localhost:3000
#   Production: https://app.flowmind.example
NEXT_PUBLIC_APP_URL=http://localhost:3000
