# FlowMind — environment variables.
# Copy this file to `.env.local` (gitignored) and fill in real values from
# your Supabase project dashboard. Never commit `.env.local`.

# Supabase project URL (e.g. https://xxx.supabase.co).
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (sb_publishable_...). Legacy name: anon key.
# Safe to expose to the browser. RLS enforces per-user access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role key. BYPASSES RLS.
# MUST NEVER be exposed to the browser. Every file that imports this key
# must start with `import 'server-only'`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini / BYOK -----------------------------------------------------------
# Optional PLATFORM credential. Used by story-to-graph generation when no user
# BYOK credential is present. For the LLM Response node it is used ONLY when
# ALLOW_PLATFORM_GEMINI_LLM_FALLBACK=true (see below) — otherwise it never
# becomes an uncapped paid LLM fallback in production. Server-only.
GEMINI_API_KEY=

# Server-only 32-byte key (base64) that encrypts the BYOK session cookie.
# Required for user BYOK. Generate one with:
#   openssl rand -base64 32
# Never expose to the browser; never use the NEXT_PUBLIC_ prefix.
BYOK_ENCRYPTION_KEY=

# Session lifetime for a connected BYOK key, in minutes (default 240 = 4h).
GEMINI_BYOK_TTL_MINUTES=240

# Gemini model names. If only one is set, both generation + graph use it.
# Defaults to gemini-2.0-flash when unset.
GEMINI_GENERATION_MODEL=
GEMINI_GRAPH_MODEL=

# --- FlowMind Groq demo (LLM Response node only) -----------------------------
# A LIMITED, server-funded fallback for the LLM Response node so a signed-in
# user without their own Gemini key still gets real AI responses. This is NOT
# unlimited public inference — it is quota-controlled and intended for a
# recruiter-facing prototype. Scope: the LLM Response node only. It does NOT
# power story-to-graph generation, embeddings, RAG, or public hosted chats.
#
# Precedence for the LLM Response node:
#   Gemini BYOK → Groq demo → (platform Gemini, only if explicitly enabled)
#   → deterministic simulation.

# Turn the Groq demo on. Must be exactly "true" AND GROQ_API_KEY must be set.
GROQ_DEMO_ENABLED=false

# Server-only Groq API key. https://console.groq.com  (never NEXT_PUBLIC_*).
GROQ_API_KEY=

# Default model for the LLM Response node.
GROQ_LLM_MODEL=openai/gpt-oss-20b

# Max Groq demo calls per authenticated user per UTC day.
GROQ_DEMO_USER_DAILY_LIMIT=5

# Max Groq demo calls across the entire deployment per UTC day.
GROQ_DEMO_GLOBAL_DAILY_LIMIT=100

# Stricter prompt character limit for platform-funded requests.
GROQ_DEMO_MAX_PROMPT_CHARS=6000

# Max response length (tokens).
GROQ_DEMO_MAX_OUTPUT_TOKENS=300

# Provider timeout (ms).
GROQ_REQUEST_TIMEOUT_MS=30000

# Allow the platform GEMINI_API_KEY to serve as the LLM Response node fallback.
# Disabled by default so a graph-generation key never becomes an uncapped paid
# LLM fallback. When not exactly "true", the LLM node will not use it.
ALLOW_PLATFORM_GEMINI_LLM_FALLBACK=false

# Optional: get notified when someone signs in / signs up. Paste a Slack or
# Discord Incoming Webhook URL. Server-only; leave blank to disable.
LOGIN_NOTIFY_WEBHOOK_URL=

# Public app URL (no trailing slash). Used for auth redirects, invite URLs,
# hosted chat links, and the embed snippet served by /widget.js.
# Examples:
#   Local:      http://localhost:3000
#   Production: https://app.flowmind.example
NEXT_PUBLIC_APP_URL=http://localhost:3000
